<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="myHeatingViewer.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <userSettings>
        <myHeatingViewer.Properties.Settings>
            <setting name="ElectricityColour" serializeAs="String">
                <value>Green</value>
            </setting>
            <setting name="GalleryColour" serializeAs="String">
                <value>Blue</value>
            </setting>
            <setting name="MiddleColour" serializeAs="String">
                <value>Orange</value>
            </setting>
            <setting name="OutsideColour" serializeAs="String">
                <value>DarkCyan</value>
            </setting>
            <setting name="SanctuaryColour" serializeAs="String">
                <value>Magenta</value>
            </setting>
            <setting name="ThermostatColour" serializeAs="String">
                <value>Goldenrod</value>
            </setting>
            <setting name="SetTempColour" serializeAs="String">
                <value>DarkRed</value>
            </setting>
            <setting name="ActualTempColour" serializeAs="String">
                <value>Yellow</value>
            </setting>
            <setting name="ChurchSensorColour" serializeAs="String">
                <value>Purple</value>
            </setting>
            <setting name="StateColour" serializeAs="String">
                <value>Red</value>
            </setting>
            <setting name="YAxisMin" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="YAxisMax" serializeAs="String">
                <value>60</value>
            </setting>
        </myHeatingViewer.Properties.Settings>
    </userSettings>
</configuration>